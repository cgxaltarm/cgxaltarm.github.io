[Unit]
Description=DailyFlo Router Gateway
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/dailyflo-router
Environment=PORT=20128
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_PUBLIC_BASE_URL=https://ai.dailyflo.me
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
